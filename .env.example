# Shadow IDP Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://idp_user:idp_password@postgres:5432/idp_db
POSTGRES_DB=idp_db
POSTGRES_USER=idp_user
POSTGRES_PASSWORD=idp_password

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API Gateway Configuration
API_GATEWAY_PORT=8080
FRONTEND_URL=http://localhost:3000

# Service URLs
GITOPS_SERVICE_URL=http://gitops-core:8080
CICD_SERVICE_URL=http://cicd-engine:8080
SERVICE_CATALOG_URL=http://service-catalog:8080
METRICS_SERVICE_URL=http://metrics-collector:8080
ALERT_SERVICE_URL=http://alert-engine:8080
TEAM_SERVICE_URL=http://team-management:8080
DOCS_SERVICE_URL=http://docs-engine:8080

# Observability Configuration
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
JAEGER_URL=http://jaeger:16686

# Git Configuration
GIT_DEFAULT_BRANCH=main
REPOS_PATH=/app/repos
TEMPLATES_PATH=/app/templates

# Logging Configuration
LOG_LEVEL=info
NODE_ENV=development

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8080

# Security Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Notification Configuration (Optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# External Integrations (Optional)
GITHUB_TOKEN=
GITLAB_TOKEN=
DOCKER_REGISTRY_URL=
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=

# Kubernetes Configuration (Optional)
KUBECONFIG_PATH=
KUBERNETES_NAMESPACE=shadow-idp

